      <aliases enabled='yes' />
      <column caption='Avg Points per Round' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1035827962490433537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Points])&#13;&#10;/&#13;&#10;COUNTD([Round])' />
      </column>
      <column caption='Points per Participant Round' datatype='integer' name='[Calculation_1035827962490970114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Participant], [Round] :&#13;&#10;    MIN([Round Points])&#13;&#10;}' />
      </column>
      <column caption='Round Points StdDev' datatype='real' name='[Calculation_1035827962491092995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV(&#13;&#10;    [Calculation_1035827962490970114]&#13;&#10;)' />
      </column>
      <column caption='Selected Tipper Filter' datatype='boolean' name='[Calculation_1035827962506444804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Participant] = [Parameters].[Tip Away Goals Parameter]' />
      </column>
      <column caption='Selected Tipper Highlight' datatype='string' name='[Calculation_1035827962522144773]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Participant] = [Parameters].[Tip Away Goals Parameter]&#13;&#10;THEN &quot;Selected&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Selected Exact Score Rate' datatype='real' name='[Calculation_1035827962541887494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Participant]) = [Parameters].[Tip Away Goals Parameter]&#13;&#10;THEN [Calculation_1592303990832013318]&#13;&#10;END' />
      </column>
      <column caption='Selected Round Points StdDev' datatype='real' name='[Calculation_1035827962544406535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Participant]) = [Parameters].[Tip Away Goals Parameter]&#13;&#10;THEN [Calculation_1035827962491092995]&#13;&#10;END' />
      </column>
      <column caption='Latest Round' datatype='integer' name='[Calculation_1035827962547564552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX([Round]) }' />
      </column>
      <column caption='Current Rank' datatype='integer' name='[Calculation_1035827962547658761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Participant] :&#13;&#10;    MIN(&#13;&#10;        IF [Round] = [Calculation_1035827962547564552]&#13;&#10;        THEN [Rank After Round]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Top 5 Comparison Rank' datatype='integer' name='[Calculation_1035827962547757066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1035827962547658761] &lt;= 1&#13;&#10;AND [Participant] &lt;&gt; [Parameters].[Tip Away Goals Parameter]&#13;&#10;THEN [Rank After Round]&#13;&#10;END' />
      </column>
      <column caption='Selected Tipper Rank' datatype='integer' name='[Calculation_1035827962547937291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Participant] = [Parameters].[Tip Away Goals Parameter]&#13;&#10;THEN [Rank After Round]&#13;&#10;END' />
      </column>
      <column caption='Submitted Tip Count' datatype='integer' name='[Calculation_1592303990825082880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Tip Submitted] THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='No Tip Count' datatype='integer' name='[Calculation_1592303990825218049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Tip Submitted] THEN 0&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='Submission Rate' datatype='real' default-format='p0.0%' name='[Calculation_1592303990826643459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1592303990825082880])&#13;&#10;/&#13;&#10;COUNT([Match Key (Tips Long)])' />
      </column>
      <column caption='Exact Score Rate' datatype='real' default-format='p0.0%' name='[Calculation_1592303990832013318]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Tip Submitted] AND [Exact Score]&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([Calculation_1592303990825082880])' />
      </column>
      <column caption='Outcome Accuracy' datatype='real' default-format='p0.0%' name='[Calculation_1592303990832562183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Tip Submitted] AND [Correct Outcome]&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM([Calculation_1592303990825082880])' />
      </column>
      <column caption='Prediction Share' datatype='real' default-format='p0.0%' name='[Calculation_1592303990839562248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Tip Submitted] THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;MIN(&#13;&#10;    { FIXED :&#13;&#10;        SUM(&#13;&#10;            IF [Tip Submitted] THEN 1&#13;&#10;            ELSE 0&#13;&#10;            END&#13;&#10;        )&#13;&#10;    }&#13;&#10;)' />
      </column>
      <column caption='Actual Home Share' datatype='real' name='[Calculation_1592303990839771145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    COUNTD(&#13;&#10;        IF [Actual Outcome] = &quot;Home Win&quot;&#13;&#10;        THEN [Match Key]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;/&#13;&#10;{ FIXED :&#13;&#10;    COUNTD([Match Key])&#13;&#10;}' />
      </column>
      <column caption='Actual Draw Share' datatype='real' default-format='p0.0%' name='[Calculation_1592303990839816202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    COUNTD(&#13;&#10;        IF [Actual Outcome] = &quot;Draw&quot;&#13;&#10;        THEN [Match Key]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;/&#13;&#10;{ FIXED :&#13;&#10;    COUNTD([Match Key])&#13;&#10;}' />
      </column>
      <column caption='Actual Away Share' datatype='real' default-format='p0.0%' name='[Calculation_1592303990839881739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    COUNTD(&#13;&#10;        IF [Actual Outcome] = &quot;Away Win&quot;&#13;&#10;        THEN [Match Key]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;/&#13;&#10;{ FIXED :&#13;&#10;    COUNTD([Match Key])&#13;&#10;}' />
      </column>
      <column caption='Actual Share' datatype='real' default-format='p0.0%' name='[Calculation_1592303990840033292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE ATTR([Tip Outcome])&#13;&#10;&#13;&#10;WHEN &quot;Home Win&quot; THEN MIN([Calculation_1592303990839771145])&#13;&#10;&#13;&#10;WHEN &quot;Draw&quot; THEN MIN([Calculation_1592303990839816202])&#13;&#10;&#13;&#10;WHEN &quot;Away Win&quot; THEN MIN([Calculation_1592303990839881739])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Match Key (Tips Long) (copy)' datatype='string' name='[Match Key (Tips Long) (copy)_1592303990831128581]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Match Key (Tips Long)]' />
      </column>
